# KejaLink environment variables
# Copy this file to .env.local and fill in your values.

# Base URL of the KejaLink backend API (no trailing slash).
# Leave empty to run the app in mock mode (no backend required).
# Local dev:  http://localhost:4000
# Docker:     http://localhost:3000
# Production: https://api.kejalink.co.ke
VITE_API_BASE_URL=http://localhost:4000
