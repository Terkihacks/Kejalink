# KejaLink environment variables
# Copy this file to .env.local and fill in your values.

# Base URL of the KejaLink backend API (no trailing slash).
# Leave empty to run the app in mock mode (no backend required).
#
# Local dev: use /api — the backend's CORS config only allows the deployed
# Vercel origin, not localhost, so the Vite dev proxy (see vite.config.ts)
# forwards /api/* to the live backend and keeps requests same-origin.
# Production (Vercel, whose origin IS allowed by the backend's CORS config):
# point straight at the backend, no proxy needed:
#   https://kejalink-server.onrender.com
#
# Note: the backend runs on Render's free tier and spins down after ~15 min
# idle — the first request after a lull can take 30-50s to wake it up.
VITE_API_BASE_URL=/api
